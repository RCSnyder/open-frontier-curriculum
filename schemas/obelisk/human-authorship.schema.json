{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://open-frontier.example/schemas/obelisk/human-authorship.schema.json",
  "title": "Obelisk human authorship",
  "required": [
    "version",
    "definition",
    "note",
    "domains"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "definition": {
      "type": "string",
      "minLength": 20
    },
    "note": {
      "type": "string"
    },
    "domains": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "human_accountability",
          "ai_role",
          "formation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^HA[0-9]{2}$"
          },
          "domain": {
            "type": "string"
          },
          "human_accountability": {
            "type": "string"
          },
          "ai_role": {
            "type": "string"
          },
          "formation": {
            "type": "string"
          }
        }
      }
    }
  }
}
