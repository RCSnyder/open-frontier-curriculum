{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://open-frontier.example/schemas/obelisk/scarcity-shift.schema.json",
  "title": "Obelisk scarcity shift",
  "required": [
    "version",
    "thesis",
    "scarcities"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "thesis": {
      "type": "string"
    },
    "scarcities": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "why",
          "formation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SC[0-9]{2}$"
          },
          "name": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "formation": {
            "type": "string"
          }
        }
      }
    }
  }
}
