{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-frontier.example/schemas/obelisk/module.schema.json",
  "title": "Obelisk module",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "branch_id",
    "title",
    "status",
    "prerequisite_ids",
    "exit_capability",
    "gate",
    "formation_modes",
    "ai_modes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 2
    },
    "branch_id": {
      "type": "string",
      "pattern": "^(TS|HW|EX|ML|DR)$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "prerequisite_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "core_concepts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "exit_capability": {
      "type": "string",
      "minLength": 1
    },
    "deletion_reason": {
      "type": "string"
    },
    "formation_modes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "ai_modes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
