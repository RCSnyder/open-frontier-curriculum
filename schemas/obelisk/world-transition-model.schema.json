{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://open-frontier.example/schemas/obelisk/world-transition-model.schema.json",
  "title": "Obelisk world transition model",
  "required": [
    "version",
    "status",
    "theses"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "theses": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "confidence",
          "thesis",
          "evidence_refs",
          "implication"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^WT[0-9]{2}$"
          },
          "title": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "thesis": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "implication": {
            "type": "string"
          }
        }
      }
    }
  }
}
