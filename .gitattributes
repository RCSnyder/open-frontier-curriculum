# Keep curriculum source data in normal Git so pull requests show useful diffs.
data/*.csv text eol=lf -filter diff merge

# Markdown and source files use normalized line endings.
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Binary archive files stay binary, but do not require Git LFS.
*.xlsx binary -filter
*.png binary -filter
*.jpg binary -filter
*.jpeg binary -filter
*.zip binary -filter
